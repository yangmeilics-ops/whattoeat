.panel { background: #FFF9F6; border-radius: 28rpx; }
.p-title { color: #5A4B40; border-left: 5rpx solid #F87860; padding-left: 16rpx; }
.p-input { border-color: #EAC5B9; background: #FFFFFF; border-radius: 16rpx; color: #5A4B40; }
.p-ph { color: #8B7569; }
.p-meal { border-color: #F5E0D8; color: #806A5C; border-radius: 100rpx; }
.p-meal.on { background: #FFEAE1; color: #AD4935; border-color: #F87860; }
.p-ok { background: #C9503B; border-radius: 100rpx; }

